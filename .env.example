# Copy this file to ".env" and fill in your real values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# Neon PostgreSQL connections
# Pooled connection string for normal application queries
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=verify-full
# Direct (non-pooled) connection string for migrations & scripts
DATABASE_URL_DIRECT=postgresql://user:password@your-neon-direct-host/neondb?sslmode=verify-full

# Frontend URLs allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign JWT auth tokens (use a long random string in production, min 32 chars)
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars

# Password given to the SAMPLE users created by "npm run seed" (stored only as a bcrypt hash).
SEED_DEFAULT_PASSWORD=your_sample_user_password_here
